# 3D files and binaries go to Git LFS (light history, full versions)
*.3mf    filter=lfs diff=mesh3d merge=lfs -text
*.stl    filter=lfs diff=mesh3d merge=lfs -text
*.STL    filter=lfs diff=mesh3d merge=lfs -text
*.obj    filter=lfs diff=mesh3d merge=lfs -text
*.step   filter=lfs diff=lfs merge=lfs -text
*.stp    filter=lfs diff=lfs merge=lfs -text
*.f3d    filter=lfs diff=lfs merge=lfs -text
*.f3z    filter=lfs diff=lfs merge=lfs -text
*.blend  filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text
*.FCStd  filter=lfs diff=lfs merge=lfs -text
*.fcstd  filter=lfs diff=lfs merge=lfs -text
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.webp   filter=lfs diff=lfs merge=lfs -text
*.svg    text eol=lf

# Text sources: versioned normally
*.scad   text eol=lf
*.py     text eol=lf
*.md     text eol=lf
*.cmd    text eol=crlf
